<!DOCTYPE html>
<html>
<head>
    <meta charset="UTF-8">
    <title>{% block title %}Assist'IA{% endblock %}</title>
    <script src="https://cdn.tailwindcss.com"></script>
    {{ importmap('app') }}
</head>
<body class="bg-gray-50 text-gray-900 min-h-screen flex flex-col">
    <header class="bg-white border-b border-gray-100 shadow-sm px-6 py-4">
        <div class="max-w-6xl mx-auto flex items-center justify-between">
            <a href="{{ path('app_home') }}" class="text-xl font-bold text-rose-400">Assist'IA</a>
            <nav class="flex items-center gap-5 text-sm">
                <a href="{{ path('public_property_index') }}" class="text-gray-600 hover:text-rose-400">Biens</a>
                <a href="{{ path('public_appointment') }}" class="text-gray-600 hover:text-rose-400">Prendre RDV</a>
                <a href="{{ path('public_contact') }}" class="text-gray-600 hover:text-rose-400">Contact</a>
                {% if app.user %}
                    <a href="{{ path('agent_dashboard') }}" class="text-gray-600 hover:text-rose-400">Mon espace</a>
                    <a href="{{ path('app_logout') }}" class="text-gray-600 hover:text-rose-400">Déconnexion</a>
                {% endif %}
            </nav>
        </div>
    </header>

    <main class="flex-1 px-6 py-6">
        {% block body %}{% endblock %}
    </main>

    <footer class="border-t border-gray-100 bg-white px-6 py-4 text-sm text-gray-500">
        <div class="max-w-6xl mx-auto flex flex-col md:flex-row md:items-center md:justify-between gap-2">
            <p>Assist'IA — votre recherche immobilière simplifiée</p>
            <div class="flex gap-4">
                <a href="{{ path('app_privacy') }}" class="hover:text-rose-400">Confidentialité</a>
                {% if not app.user %}
                    <a href="{{ path('app_login') }}" class="hover:text-rose-400">Espace agent</a>
                {% endif %}
            </div>
        </div>
    </footer>
</body>
</html>
