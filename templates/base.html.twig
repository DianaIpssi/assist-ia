<!DOCTYPE html>
<html>
<head>
    <meta charset="UTF-8">
    <title>{% block title %}Assist'IA{% endblock %}</title>

    <script src="https://cdn.tailwindcss.com"></script>

    {{ importmap('app') }}
</head>
<body class="bg-white text-gray-900 min-h-screen">
    <header class="bg-white border-b border-gray-100 shadow-sm px-6 py-4 mb-6 flex items-center justify-between">
        <a href="{{ path('app_home') }}" class="text-xl font-bold text-rose-400">Assist'IA</a>
        <nav class="flex items-center gap-4 text-sm">
            <a href="{{ path('public_property_index') }}" class="text-gray-600 hover:text-rose-400">Biens</a>
            {% if app.user %}
                <a href="{{ path('agent_dashboard') }}" class="text-gray-600 hover:text-rose-400">Dashboard</a>
                <a href="{{ path('app_logout') }}" class="text-gray-600 hover:text-rose-400">Déconnexion</a>
            {% else %}
                <a href="{{ path('app_login') }}" class="text-gray-600 hover:text-rose-400">Connexion</a>
            {% endif %}
            <a href="{{ path('app_privacy') }}" class="text-gray-500 hover:text-rose-400">Confidentialité</a>
        </nav>
    </header>

    <main class="px-6">
        {% block body %}{% endblock %}
    </main>
</body>
</html>
