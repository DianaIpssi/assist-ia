{% extends 'base.html.twig' %}

{% block title %}Page introuvable - Assist'IA{% endblock %}

{% block body %}
<div class="max-w-xl mx-auto py-16 text-center">
    <p class="text-6xl font-bold text-rose-400 mb-4">404</p>
    <h1 class="text-3xl font-bold mb-4">Cette page n'existe pas</h1>
    <p class="text-gray-600 mb-8">
        Le lien est peut-être incorrect, ou le bien n'est plus en ligne.
    </p>

    <div class="flex flex-col sm:flex-row gap-3 justify-center">
        <a href="{{ path('public_property_index') }}"
           class="inline-flex items-center justify-center px-5 h-11 rounded-lg bg-rose-400 text-white font-semibold hover:bg-rose-500">
            Voir les biens
        </a>
        <a href="{{ path('app_home') }}"
           class="inline-flex items-center justify-center px-5 h-11 rounded-lg bg-gray-100 text-gray-800 font-semibold hover:bg-gray-200">
            Retour à l'accueil
        </a>
    </div>
</div>
{% endblock %}
