{% extends 'base.html.twig' %}

{% block title %}Erreur - Assist'IA{% endblock %}

{% block body %}
<div class="max-w-xl mx-auto py-16 text-center">
    <p class="text-6xl font-bold text-rose-400 mb-4">{{ status_code }}</p>

    {% if status_code == 403 %}
        <h1 class="text-3xl font-bold mb-4">Accès refusé</h1>
        <p class="text-gray-600 mb-8">Vous n'avez pas les droits pour accéder à cette page.</p>
    {% else %}
        <h1 class="text-3xl font-bold mb-4">Une erreur est survenue</h1>
        <p class="text-gray-600 mb-8">Le problème vient de notre côté. Réessayez dans quelques instants.</p>
    {% endif %}

    <a href="{{ path('app_home') }}"
       class="inline-flex items-center justify-center px-5 h-11 rounded-lg bg-rose-400 text-white font-semibold hover:bg-rose-500">
        Retour à l'accueil
    </a>
</div>
{% endblock %}
