{% extends 'base.html.twig' %}

{% block title %}Nos biens - Assist'IA{% endblock %}

{% block body %}
<div class="max-w-6xl mx-auto py-10">
    <h1 class="text-3xl font-bold mb-6">Nos biens disponibles</h1>

    <form method="get" action="{{ path('public_property_index') }}" role="search" aria-label="Filtrer les biens"
          class="bg-white border border-gray-100 shadow-sm rounded-2xl p-5 mb-4 grid gap-4 md:grid-cols-4 md:items-end">
        <div>
            <label for="filter-ville" class="block text-sm font-medium text-gray-700 mb-1">Ville</label>
            <input type="text" id="filter-ville" name="ville" value="{{ filters.ville }}" placeholder="Ex : Lyon"
                   class="w-full h-11 px-3 rounded-lg border border-gray-200 focus:outline-none focus:ring-2 focus:ring-rose-300">
        </div>
        <div>
            <label for="filter-type" class="block text-sm font-medium text-gray-700 mb-1">Type de bien</label>
            <select id="filter-type" name="type"
                    class="w-full h-11 px-3 rounded-lg border border-gray-200 bg-white focus:outline-none focus:ring-2 focus:ring-rose-300">
                <option value="">Tous les types</option>
                {% for value, label in propertyTypes %}
                    <option value="{{ value }}" {{ filters.type == value ? 'selected' }}>{{ label }}</option>
                {% endfor %}
                {% if filters.type and filters.type not in propertyTypes|keys %}
                    <option value="{{ filters.type }}" selected>{{ filters.type|upper }}</option>
                {% endif %}
            </select>
        </div>
        <div>
            <label for="filter-budget" class="block text-sm font-medium text-gray-700 mb-1">Budget max (€)</label>
            <input type="number" id="filter-budget" name="budget" value="{{ filters.budget }}" min="0" step="1000" placeholder="Ex : 200000"
                   class="w-full h-11 px-3 rounded-lg border border-gray-200 focus:outline-none focus:ring-2 focus:ring-rose-300">
        </div>
        <div class="flex gap-2">
            <button type="submit" class="flex-1 h-11 rounded-lg bg-rose-400 text-white font-semibold hover:bg-rose-500">Filtrer</button>
            {% if hasFilters %}
                <a href="{{ path('public_property_index') }}"
                   class="inline-flex items-center justify-center px-4 h-11 rounded-lg bg-gray-100 text-gray-800 font-semibold hover:bg-gray-200">Réinitialiser</a>
            {% endif %}
        </div>
    </form>

    <p class="text-sm text-gray-500 mb-6" aria-live="polite">{{ properties|length }} bien(s) trouvé(s)</p>

    <div class="grid md:grid-cols-2 lg:grid-cols-3 gap-6">
        {% for property in properties %}
            <article class="bg-white border border-gray-100 shadow-sm rounded-2xl overflow-hidden flex flex-col">
                <img src="{{ property.displayImageUrl }}"
                     alt="{{ property.title }}"
                     class="w-full h-48 object-cover">

                <div class="p-5 flex flex-col flex-1">
                    <h2 class="text-xl font-bold mb-1">{{ property.title }}</h2>

                    {% if property.city %}
                        <p class="text-sm text-gray-500 mb-2">{{ property.city }}{% if property.postalCode %} ({{ property.postalCode }}){% endif %}</p>
                    {% endif %}

                    {% if property.description %}
                        <p class="text-gray-600 text-sm line-clamp-2">{{ property.description }}</p>
                    {% endif %}

                    <p class="font-semibold text-rose-500 mt-3 text-lg">{{ property.price|number_format(0, ',', ' ') }} €</p>

                    {% if property.agent %}
                        <p class="text-sm text-gray-500 mt-2">
                            Proposé par {{ property.agent.fullName }}{% if property.agent.agencyName %} · {{ property.agent.agencyName }}{% endif %}
                        </p>
                    {% endif %}

                    <div class="mt-auto pt-4">
                        <a href="{{ path('public_property_show', {'id': property.id}) }}"
                           class="inline-flex items-center justify-center w-full px-4 h-11 rounded-lg bg-rose-400 text-white font-semibold hover:bg-rose-500">
                            Voir le détail
                        </a>
                    </div>
                </div>
            </article>
        {% else %}
            <p>{{ hasFilters ? 'Aucun bien ne correspond à ces critères. Essayez un budget plus large ou une autre ville.' : 'Aucun bien pour le moment.' }}</p>
        {% endfor %}
    </div>
</div>
<div id="react-chat" class="fixed bottom-6 right-6 z-50 max-w-[calc(100vw-2rem)]"></div>
{% endblock %}
