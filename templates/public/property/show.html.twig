{% extends 'base.html.twig' %}

{% block title %}{{ property.title }} - Assist'IA{% endblock %}
{% block meta_description %}{{ property.title }}{% if property.city %} à {{ property.city }}{% endif %}, {{ property.price|number_format(0, ',', ' ') }} €. {{ property.description|default('')|striptags|slice(0, 110) }}{% endblock %}

{% block body %}
<div class="max-w-4xl mx-auto py-8 space-y-6">
    <section class="bg-white rounded-2xl border border-gray-100 shadow-sm overflow-hidden">
        <img src="{{ property.displayImageUrl }}"
             alt="{{ property.title }}"
             class="w-full h-72 object-cover">

        <div class="p-6 md:p-8">
            <div class="flex flex-col md:flex-row md:items-center md:justify-between gap-4 mb-6">
                <div>
                    <p class="text-sm text-gray-500">Bien immobilier</p>
                    <h1 class="text-3xl font-bold">{{ property.title }}</h1>
                </div>
                <div class="flex flex-wrap gap-2">
                    <a href="{{ path('public_contact', {bien: property.id}) }}" class="px-4 py-2 rounded-lg bg-rose-400 text-white font-semibold hover:bg-rose-500">
                        Contacter l'agent
                    </a>
                    <a href="{{ path('public_property_index') }}" class="px-4 py-2 rounded-lg bg-gray-100 text-gray-900 font-semibold hover:bg-gray-200">
                        Retour aux biens
                    </a>
                </div>
            </div>

            <div class="grid md:grid-cols-2 gap-5">
                <article class="rounded-xl border border-gray-100 p-4">
                    <p class="text-sm text-gray-500">Prix</p>
                    <p class="text-lg font-semibold mt-1 text-rose-500">{{ property.price|number_format(0, ',', ' ') }} €</p>
                </article>
                <article class="rounded-xl border border-gray-100 p-4">
                    <p class="text-sm text-gray-500">Localisation</p>
                    <p class="text-lg font-semibold mt-1">
                        {{ property.city ?: '-' }}
                        {% if property.postalCode %}
                            ({{ property.postalCode }})
                        {% endif %}
                    </p>
                </article>
                {% if property.surface or property.rooms %}
                    <article class="rounded-xl border border-gray-100 p-4">
                        <p class="text-sm text-gray-500">Surface / Pièces</p>
                        <p class="text-lg font-semibold mt-1">
                            {% if property.surface %}{{ property.surface }} m²{% endif %}
                            {% if property.rooms %} · {{ property.rooms }} pièces{% endif %}
                        </p>
                    </article>
                {% endif %}
                <article class="md:col-span-2 rounded-xl border border-gray-100 p-4">
                    <p class="text-sm text-gray-500">Description</p>
                    <p class="mt-1 text-gray-800">{{ property.description ?: 'Aucune description fournie.' }}</p>
                </article>
                {% if property.agent %}
                    <article class="md:col-span-2 rounded-xl border border-gray-100 p-4 flex flex-wrap items-center justify-between gap-3">
                        <div>
                            <p class="text-sm text-gray-500">Agent responsable</p>
                            <p class="text-lg font-semibold mt-1">{{ property.agent.fullName }}</p>
                            {% if property.agent.agencyName %}
                                <p class="text-sm text-gray-600">{{ property.agent.agencyName }}</p>
                            {% endif %}
                        </div>
                        {% if 'ROLE_ADMIN' not in property.agent.roles %}
                            <a href="{{ path('public_appointment', {agent: property.agent.id}) }}" class="px-4 py-2 rounded-lg bg-gray-100 text-gray-900 font-semibold hover:bg-gray-200">
                                Prendre RDV avec cet agent
                            </a>
                        {% endif %}
                    </article>
                {% endif %}
            </div>
        </div>
    </section>
</div>
<div id="react-chat" class="fixed bottom-6 right-6 z-50 max-w-[calc(100vw-2rem)]"></div>
{% endblock %}
