{% extends 'base.html.twig' %}

{% block title %}{{ property.title }} - Assist'IA{% endblock %}

{% block body %}
<div class="max-w-4xl mx-auto py-8 space-y-6">
    <section class="bg-white rounded-2xl border border-gray-100 shadow-sm p-6 md:p-8">
        <div class="flex flex-col md:flex-row md:items-center md:justify-between gap-4 mb-6">
            <div>
                <p class="text-sm text-gray-500">Bien immobilier</p>
                <h1 class="text-3xl font-bold">{{ property.title }}</h1>
            </div>
            <a href="{{ path('public_property_index') }}" class="px-4 py-2 rounded-lg bg-gray-100 text-gray-900 font-semibold hover:bg-gray-200">
                Retour aux biens
            </a>
        </div>

        <div class="grid md:grid-cols-2 gap-5">
            <article class="rounded-xl border border-gray-100 p-4">
                <p class="text-sm text-gray-500">Prix</p>
                <p class="text-lg font-semibold mt-1">{{ property.price }} EUR</p>
            </article>
            <article class="rounded-xl border border-gray-100 p-4">
                <p class="text-sm text-gray-500">Localisation</p>
                <p class="text-lg font-semibold mt-1">
                    {{ property.city ?: '-' }}
                    {% if property.postalCode %}
                        ({{ property.postalCode }})
                    {% endif %}
                </p>
            </article>
            <article class="md:col-span-2 rounded-xl border border-gray-100 p-4">
                <p class="text-sm text-gray-500">Description</p>
                <p class="mt-1 text-gray-800">{{ property.description ?: 'Aucune description fournie.' }}</p>
            </article>
        </div>
    </section>
</div>
<div id="react-chat" class="fixed bottom-6 right-6"></div>
{% endblock %}
