{% extends 'base.html.twig' %}

{% block title %}Calendrier - Assist'IA{% endblock %}

{% block body %}
<div class="max-w-5xl mx-auto space-y-6">
    <div class="flex flex-col md:flex-row md:items-center md:justify-between gap-4">
        <div>
            <h1 class="text-3xl font-bold">Mon calendrier</h1>
            <p class="text-gray-600 mt-1">Créneaux disponibles et rendez-vous clients</p>
            <p class="text-sm text-gray-500 mt-2">Les créneaux des 14 prochains jours ouvrés (10h et 14h) sont générés automatiquement. Vous pouvez aussi en ajouter manuellement.</p>
        </div>
        <div class="flex gap-3">
            <a href="{{ path('agent_calendar_new') }}" class="px-4 py-2 rounded-lg bg-rose-400 text-white font-semibold hover:bg-rose-500">
                + Ajouter un créneau
            </a>
            <a href="{{ path('agent_dashboard') }}" class="px-4 py-2 rounded-lg bg-gray-100 text-gray-900 font-semibold hover:bg-gray-200">
                Dashboard
            </a>
        </div>
    </div>

    {% for message in app.flashes('success') %}
        <div class="rounded-lg bg-green-50 border border-green-200 text-green-800 px-4 py-3">{{ message }}</div>
    {% endfor %}

    <section class="grid lg:grid-cols-2 gap-6">
        <div class="bg-white rounded-2xl border border-gray-100 shadow-sm p-6">
            <h2 class="text-xl font-semibold mb-4">Mes créneaux</h2>
            {% if slots is empty %}
                <p class="text-gray-600">Aucun créneau. Ajoutez-en pour que les clients puissent réserver.</p>
            {% else %}
                <ul class="space-y-3">
                    {% for slot in slots %}
                        <li class="flex items-center justify-between border border-gray-100 rounded-lg p-3">
                            <div>
                                <p class="font-medium">{{ slot.startAt|date('d/m/Y H:i') }} – {{ slot.endAt|date('H:i') }}</p>
                                <p class="text-sm text-gray-500">{{ slot.note ?: 'Créneau visite' }}</p>
                            </div>
                            <span class="text-xs font-semibold px-2 py-1 rounded-full {{ slot.isAvailable ? 'bg-green-100 text-green-700' : 'bg-gray-100 text-gray-600' }}">
                                {{ slot.isAvailable ? 'Disponible' : 'Réservé' }}
                            </span>
                        </li>
                    {% endfor %}
                </ul>
            {% endif %}
        </div>

        <div class="bg-white rounded-2xl border border-gray-100 shadow-sm p-6">
            <h2 class="text-xl font-semibold mb-4">Rendez-vous à venir</h2>
            {% if appointments is empty %}
                <p class="text-gray-600">Aucun rendez-vous pour le moment.</p>
            {% else %}
                <ul class="space-y-3">
                    {% for appointment in appointments %}
                        <li class="border border-gray-100 rounded-lg p-3">
                            <p class="font-medium">{{ appointment.clientName }}</p>
                            <p class="text-sm text-gray-500">{{ appointment.clientEmail }}</p>
                            <p class="text-sm mt-1">
                                {{ appointment.slot.startAt|date('d/m/Y H:i') }}
                            </p>
                            {% if appointment.message %}
                                <p class="text-sm text-gray-600 mt-2">{{ appointment.message }}</p>
                            {% endif %}
                        </li>
                    {% endfor %}
                </ul>
            {% endif %}
        </div>
    </section>
</div>
{% endblock %}
