{% extends 'base.html.twig' %}

{% block title %}Dashboard Agent - Assist'IA{% endblock %}

{% block body %}
<div class="max-w-7xl mx-auto py-2 md:py-8 space-y-6 md:space-y-8">
    <section class="bg-white rounded-2xl border border-gray-100 shadow-sm p-5 md:p-8">
        <div class="flex flex-col md:flex-row md:items-center md:justify-between gap-6">
            <div>
                <p class="text-sm text-gray-500">Espace Agent Immobilier</p>
                <h2 class="text-2xl md:text-3xl font-bold mt-1">Tableau de bord</h2>
                <p class="text-gray-600 mt-2">
                    Gérez vos annonces, vos rendez-vous clients et l'historique des conversations.
                </p>
                {% if isAdminView %}
                    <p class="text-sm text-amber-700 mt-2 bg-amber-50 border border-amber-100 rounded-lg px-3 py-2 inline-block">
                        Vue administrateur — pour la gestion globale, utilisez <a href="{{ path('admin') }}" class="font-semibold underline">/admin</a>.
                    </p>
                {% endif %}
            </div>

            <div class="grid grid-cols-2 gap-2 sm:flex sm:flex-wrap md:gap-3">
                <a href="/property/new" class="col-span-2 text-center px-4 py-2 rounded-lg bg-rose-400 text-white font-semibold hover:bg-rose-500">
                    + Nouveau bien
                </a>
                <a href="/property" class="text-center px-4 py-2 rounded-lg bg-gray-100 text-gray-900 font-semibold hover:bg-gray-200">
                    Gerer mes biens
                </a>
                <a href="{{ path('agent_chats') }}" class="text-center px-4 py-2 rounded-lg bg-gray-100 text-gray-900 font-semibold hover:bg-gray-200">
                    Historique chats
                </a>
                <a href="{{ path('agent_calendar') }}" class="text-center px-4 py-2 rounded-lg bg-gray-100 text-gray-900 font-semibold hover:bg-gray-200">
                    Calendrier
                </a>
                <a href="/biens" class="text-center px-4 py-2 rounded-lg bg-gray-100 text-gray-900 font-semibold hover:bg-gray-200">
                    Vue client
                </a>
            </div>
        </div>
    </section>

    <section class="grid grid-cols-2 lg:grid-cols-5 gap-3 md:gap-4">
        <article class="bg-white rounded-xl border border-gray-100 shadow-sm p-5">
            <p class="text-sm text-gray-500">Biens totaux</p>
            <p class="text-3xl font-bold mt-2">{{ stats.totalProperties }}</p>
        </article>

        <article class="bg-white rounded-xl border border-gray-100 shadow-sm p-5">
            <p class="text-sm text-gray-500">Biens publies</p>
            <p class="text-3xl font-bold mt-2 text-rose-500">{{ stats.publishedProperties }}</p>
        </article>

        <article class="bg-white rounded-xl border border-gray-100 shadow-sm p-5">
            <p class="text-sm text-gray-500">Brouillons</p>
            <p class="text-3xl font-bold mt-2 text-rose-500">{{ stats.draftProperties }}</p>
        </article>

        <article class="bg-white rounded-xl border border-gray-100 shadow-sm p-5">
            <p class="text-sm text-gray-500">Creneaux totaux</p>
            <p class="text-3xl font-bold mt-2">{{ stats.totalSlots }}</p>
        </article>

        <article class="col-span-2 sm:col-span-1 bg-white rounded-xl border border-gray-100 shadow-sm p-5">
            <p class="text-sm text-gray-500">Creneaux disponibles</p>
            <p class="text-3xl font-bold mt-2 text-rose-600">{{ stats.availableSlots }}</p>
        </article>
    </section>

    <section class="grid lg:grid-cols-3 gap-6">
        <article class="lg:col-span-2 bg-white rounded-2xl border border-gray-100 shadow-sm p-6">
            <div class="flex items-center justify-between mb-4">
                <h3 class="text-xl font-semibold">Derniers biens ajoutes</h3>
                <a href="/property" class="text-sm font-medium text-rose-600 hover:text-rose-700">Voir tout</a>
            </div>

            {% if latestProperties is not empty %}
                <ul class="md:hidden divide-y divide-gray-100">
                    {% for property in latestProperties %}
                        <li class="py-3 flex items-center justify-between gap-3">
                            <div class="min-w-0">
                                <a href="/property/{{ property.id }}/edit" class="font-medium hover:text-rose-600">{{ property.title }}</a>
                                <p class="text-sm text-gray-500">{{ property.city ?: '-' }} · {{ property.price }} EUR</p>
                            </div>
                            <span class="shrink-0 inline-flex px-2 py-1 rounded-full text-xs font-semibold bg-gray-100 text-gray-700">
                                {{ property.status ?: 'n/a' }}
                            </span>
                        </li>
                    {% endfor %}
                </ul>
                <div class="hidden md:block overflow-auto">
                    <table class="w-full text-left">
                        <thead>
                            <tr class="text-sm text-gray-500 border-b">
                                <th class="py-2 pr-3">Titre</th>
                                <th class="py-2 pr-3">Ville</th>
                                <th class="py-2 pr-3">Prix</th>
                                <th class="py-2 pr-3">Statut</th>
                                <th class="py-2 text-right">Action</th>
                            </tr>
                        </thead>
                        <tbody>
                            {% for property in latestProperties %}
                                <tr class="border-b last:border-b-0">
                                    <td class="py-3 pr-3 font-medium">{{ property.title }}</td>
                                    <td class="py-3 pr-3">{{ property.city ?: '-' }}</td>
                                    <td class="py-3 pr-3">{{ property.price }} EUR</td>
                                    <td class="py-3 pr-3">
                                        <span class="inline-flex px-2 py-1 rounded-full text-xs font-semibold bg-gray-100 text-gray-700">
                                            {{ property.status ?: 'n/a' }}
                                        </span>
                                    </td>
                                    <td class="py-3 text-right">
                                        <a href="/property/{{ property.id }}/edit" class="text-rose-600 hover:text-rose-700 text-sm font-medium">
                                            Modifier
                                        </a>
                                    </td>
                                </tr>
                            {% endfor %}
                        </tbody>
                    </table>
                </div>
            {% else %}
                <p class="text-gray-600">Aucun bien enregistre pour le moment.</p>
            {% endif %}
        </article>

        <article class="order-first lg:order-none bg-white rounded-2xl border border-gray-100 shadow-sm p-6 space-y-4">
            <h3 class="text-xl font-semibold">Actions rapides</h3>
            <a href="/property/new" class="block w-full px-4 py-3 rounded-lg bg-rose-400 text-white font-semibold text-center hover:bg-rose-500">
                Creer une annonce
            </a>
            <a href="{{ path('agent_chats') }}" class="block w-full px-4 py-3 rounded-lg bg-gray-100 text-gray-900 font-semibold text-center hover:bg-gray-200">
                Voir les conversations clients
            </a>
            <a href="{{ path('agent_calendar') }}" class="block w-full px-4 py-3 rounded-lg bg-gray-100 text-gray-900 font-semibold text-center hover:bg-gray-200">
                Gerer mon calendrier
            </a>
            <a href="/property" class="block w-full px-4 py-3 rounded-lg bg-gray-100 text-gray-900 font-semibold text-center hover:bg-gray-200">
                Ouvrir le back-office biens
            </a>
            {% if is_granted('ROLE_ADMIN') %}
                <a href="{{ path('admin') }}" class="block w-full px-4 py-3 rounded-lg bg-gray-100 text-gray-900 font-semibold text-center hover:bg-gray-200">
                    Administration (EasyAdmin)
                </a>
            {% endif %}
        </article>
    </section>
</div>
{% endblock %}
