{% extends 'base.html.twig' %}

{% block title %}Nouveau mot de passe{% endblock %}

{% set fieldClass = 'w-full rounded-lg border border-gray-300 px-3 py-2 bg-white focus:outline-none focus:ring-2 focus:ring-rose-200 focus:border-rose-300' %}
{% set labelClass = 'block text-sm font-semibold text-gray-700 mb-1' %}

{% block body %}
<div class="max-w-md mx-auto">
    <div class="bg-white rounded-2xl border border-gray-100 shadow-sm p-8">
        <h1 class="text-2xl font-bold mb-2">Nouveau mot de passe</h1>
        <p class="text-gray-600 mb-6">Choisissez un mot de passe d'au moins 8 caractères.</p>

        {{ form_start(form, {attr: {class: 'space-y-4'}}) }}
            <div>
                {{ form_label(form.plainPassword.first, null, {label_attr: {class: labelClass}}) }}
                {{ form_widget(form.plainPassword.first, {attr: {class: fieldClass}}) }}
            </div>
            <div>
                {{ form_label(form.plainPassword.second, null, {label_attr: {class: labelClass}}) }}
                {{ form_widget(form.plainPassword.second, {attr: {class: fieldClass}}) }}
            </div>
            {{ form_errors(form.plainPassword) }}
            <button type="submit" class="w-full px-4 py-3 rounded-xl bg-rose-400 text-white font-semibold hover:bg-rose-500">
                Enregistrer
            </button>
        {{ form_end(form) }}
    </div>
</div>
{% endblock %}
