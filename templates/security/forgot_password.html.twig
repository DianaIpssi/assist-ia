{% extends 'base.html.twig' %}

{% block title %}Mot de passe oublié{% endblock %}

{% set fieldClass = 'w-full rounded-lg border border-gray-300 px-3 py-2 bg-white focus:outline-none focus:ring-2 focus:ring-rose-200 focus:border-rose-300' %}
{% set labelClass = 'block text-sm font-semibold text-gray-700 mb-1' %}

{% block body %}
<div class="max-w-md mx-auto">
    <div class="bg-white rounded-2xl border border-gray-100 shadow-sm p-8">
        <h1 class="text-2xl font-bold mb-2">Mot de passe oublié</h1>
        <p class="text-gray-600 mb-6">Entrez votre email agent pour recevoir un lien de réinitialisation.</p>

        {% for message in app.flashes('success') %}
            <div class="mb-4 rounded-lg bg-green-50 border border-green-200 text-green-800 px-4 py-3">{{ message }}</div>
        {% endfor %}

        {{ form_start(form, {attr: {class: 'space-y-4'}}) }}
            <div>
                {{ form_label(form.email, null, {label_attr: {class: labelClass}}) }}
                {{ form_widget(form.email, {attr: {class: fieldClass}}) }}
            </div>
            <button type="submit" class="w-full px-4 py-3 rounded-xl bg-rose-400 text-white font-semibold hover:bg-rose-500">
                Envoyer le lien
            </button>
        {{ form_end(form) }}

        <p class="mt-6 text-sm text-gray-500">
            <a href="{{ path('app_login') }}" class="text-rose-400 hover:underline">Retour à la connexion</a>
        </p>
    </div>
</div>
{% endblock %}
